{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      // Turborepo only forwards a non-`NEXT_PUBLIC_*` env var into a task's
      // build environment if it's declared here — everything else is
      // stripped before `next build` runs, even if it's set on the Vercel
      // project. Local dev never noticed this because `next dev` reads
      // `.env.local` directly, bypassing Turbo entirely; Vercel's build
      // goes through `turbo run build`, which is where this first showed up
      // as `KINDE_ISSUER_URL is required` during "Collecting page data" for
      // /api/auth/[kindeAuth] — the route itself was fine, Turbo just never
      // handed it the variable. Add any new server-only env var the web app
      // reads at build or request time to this list, or it'll silently be
      // missing again the next time it's added to Vercel but not here.
      "env": [
        "KINDE_DOMAIN",
        "KINDE_CLIENT_ID",
        "KINDE_CLIENT_SECRET",
        "KINDE_MOBILE_CLIENT_ID",
        "KINDE_ISSUER_URL",
        "KINDE_SITE_URL",
        "KINDE_POST_LOGIN_REDIRECT_URL",
        "KINDE_POST_LOGOUT_REDIRECT_URL",
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_JWT_SIGNING_KEY",
        "QR_SIGNING_SECRET",
        "CONNECT_IP_HASH_SALT",
        // The two OPTIONAL credentials (`env.ts` returns null rather than
        // throwing when either is unset). They were missing from this list,
        // and being optional is exactly what made that dangerous rather than
        // harmless: a required variable stripped by Turbo fails the build
        // loudly, the way KINDE_ISSUER_URL did above, while an optional one
        // stripped by Turbo just makes the feature quietly stop existing.
        //
        // EXPO_ACCESS_TOKEN is the one that matters for security. It is the
        // credential behind the card-tap push notification, which §4.7 threat
        // 7 relies on as the ONLY control on a stolen card — Q17 removed the
        // confirmation step, so detection latency is the whole defence. §4.5
        // is explicit that a notification pipeline dead for a week is a
        // security regression even though no single connection was affected.
        // Stripped here, it is dead in exactly that silent way.
        //
        // GEOCODING_API_KEY is cosmetic by comparison (a null place_label),
        // but it fails the same silent way, so it belongs here too.
        "GEOCODING_API_KEY",
        "EXPO_ACCESS_TOKEN",
        // RESEND_API_KEY is optional (same silent-failure risk as the two
        // above — stripped here, invite emails just stop sending with no
        // build error). RESEND_WEBHOOK_SECRET and EMAIL_UNSUBSCRIBE_SECRET
        // are REQUIRED, so stripping either fails the build loudly like
        // KINDE_ISSUER_URL above rather than degrading silently — but they
        // still have to be listed, or the loud failure happens on Vercel
        // instead of being caught here.
        "RESEND_API_KEY",
        "RESEND_WEBHOOK_SECRET",
        "EMAIL_UNSUBSCRIBE_SECRET",
        // Required (env.ts's emailMailingAddress()) — CAN-SPAM's physical
        // address requirement. Stripped here, the send module throws on
        // every attempt rather than shipping a compliance gap silently.
        "EMAIL_MAILING_ADDRESS"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
