# =============================================================================
# .env.example — VARIABLE NAMES ONLY, NEVER VALUES.
#
# This is the one `.env*` file git is allowed to track (see .gitignore's
# deny-all-then-allow-back rule and its reasoning). Copy it to `.env.local`
# at the repo root and fill in real values there; `.env.local` is gitignored
# and must stay that way. Nothing matching this file's name may ever contain
# a real credential.
#
# `apps/web/src/server/env.ts` documents every variable below — what it is,
# where to get it, and why it is required or optional. `turbo.json`'s build
# `env` list must name every server-only variable here, or Vercel builds
# silently strip it (see the comment in turbo.json).
# =============================================================================

# --- Kinde (identity provider; §5.1) ----------------------------------------
KINDE_DOMAIN=
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=
KINDE_SITE_URL=
KINDE_POST_LOGIN_REDIRECT_URL=
KINDE_POST_LOGOUT_REDIRECT_URL=
# Optional until the mobile app exists (§5.2): the second allowed `azp`.
KINDE_MOBILE_CLIENT_ID=

# --- Supabase (database, storage; §3, §5.4) ---------------------------------
SUPABASE_URL=
# Publishable key — public by design; grants nothing on its own.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# sb_secret_... key. Bypasses every RLS policy — server-side only, forever.
SUPABASE_SERVICE_ROLE_KEY=
# The private ES256 JWK this app signs Supabase access tokens with, one line
# of JSON. Anyone holding it can mint a token for any user.
SUPABASE_JWT_SIGNING_KEY=

# --- Connect flow (§4) ------------------------------------------------------
# HMAC key for QR tokens. Generate: `openssl rand -base64 48`.
QR_SIGNING_SECRET=
# Salt for hashed IPs in the audit log / rate limiter. Generate:
# `openssl rand -base64 32`. Must differ from any other salt.
CONNECT_IP_HASH_SALT=

# --- Optional integrations (missing = feature degrades loudly, never blocks) -
# Mapbox token for reverse-geocoded meeting place labels (§2.4, Q25).
GEOCODING_API_KEY=
# Expo push credential for the card-tap notification (§4.5, §7.5).
EXPO_ACCESS_TOKEN=
